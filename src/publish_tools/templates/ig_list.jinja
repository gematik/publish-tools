<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title | safe_escape }}</title>
    {% include 'style.html' %}
</head>
<body>
<main class="container ig-list-page">
    {% include 'brand.html' %}
    <header class="page-header">
        <p class="eyebrow">Implementation Guides</p>
        <h1>FHIR Paketübersicht</h1>
        <p class="muted">Diese Seite bietet eine Übersicht über die von der gematik veröffentlichten FHIR-Packages. Neben den aktuellen Releases werden auch Vorabversionen wie Ballots und Release Candidates dargestellt.</p>
    </header>
    {% macro edition_row(release, label='') %}
        <div class="release-heading">
            {% if release.igs | length == 1 %}<a class="badge" href="{{ release.igs[0].url | safe_escape }}">{{ release.version | safe_escape }}</a>{% else %}<span class="badge">{{ release.version | safe_escape }}</span>{% endif %}
            <span class="status-label">{{ (label or 'Veröffentlichung') | safe_escape }}</span>
        </div>
        {% for edition in release.igs %}
        <div class="edition-row single-ig">
            <div><p>{% if release.igs | length > 1 %}<a class="ig-name" href="{{ edition.url | safe_escape }}">{{ edition.description | safe_escape }}</a>{% else %}{{ edition.description | safe_escape }}{% endif %}</p>
                <p class="metadata"><span class="sequence-label">Sequence: {{ edition.name | safe_escape }}</span> · FHIR {{ edition.fhir_version | join(', ') | safe_escape }}</p>
            </div>
        </div>
        {% endfor %}
    {% endmacro %}
    {% for family, packages in groups.items() | sort %}
    <section class="package-family" aria-labelledby="family-{{ loop.index }}">
        <div class="family-heading"><h2 id="family-{{ loop.index }}">{{ family | safe_escape }}</h2><span class="count">{{ packages | length }} Pakete</span></div>
    <div class="package-list">
    {% for package in packages %}
    <article class="card">
        <div class="package-heading"><h3 class="package-title">{{ package.name | safe_escape }}</h3>
        <p class="package-id">{{ package.package_id | safe_escape }}</p></div>
        {% if package.latest %}
        <section class="release-channel stable">
            {{ edition_row(package.latest, 'Aktuelle Veröffentlichung') }}
            {% if package.older %}
            <details><summary>Ältere Veröffentlichungen <span class="count">{{ package.older | length }}</span></summary>
                <ul class="version-list">{% for edition in package.older %}<li>{{ edition_row(edition) }}</li>{% endfor %}</ul>
            </details>
            {% endif %}
        </section>
        {% else %}
        <p class="muted">Noch keine reguläre Veröffentlichung.</p>
        {% endif %}
        {% for preview in package.previews %}
        <section class="release-channel preview">
            <h4>{{ preview.name | safe_escape }}</h4>
            <ul class="version-list">{% for edition in preview.visible %}<li>{{ edition_row(edition, preview.name) }}</li>{% endfor %}</ul>
            {% if preview.older %}
            <details><summary>Ältere {{ preview.name | safe_escape }}-Versionen <span class="count">{{ preview.older | length }}</span></summary>
                <ul class="version-list">{% for edition in preview.older %}<li>{{ edition_row(edition, preview.name) }}</li>{% endfor %}</ul>
            </details>
            {% endif %}
        </section>
        {% endfor %}
    </article>
    {% endfor %}
    </div>
    </section>
    {% else %}
    <p class="card muted">Noch keine Pakete veröffentlicht.</p>
    {% endfor %}
    {% include 'footer.html' %}
</main>
</body>
</html>
