<html>

<head>
    <title>{{ title | safe_escape }} History</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    {% include 'style.html' %}
</head>

<body>
    <div class="container">
        <h1>{{ title | safe_escape }} History</h1>
        <p>{{ introduction | safe_escape }}</p>

        <table class="history-grid">
            <thead>
                <tr>
                    <th width="100px">Version</th>
                    <th>Beschreibung</th>
                </tr>
            </thead>
            <tbody>
                {% for sequence, entries in sequences.items() | sort_sequences(reverse=True) %}
                <tr class="sequence">
                    <td colspan="3">{{ sequence | safe_escape }}</td>
                </tr>
                {% for entry in entries | sort(attribute="version", reverse=True) %}
                <tr>
                    <td><a href="{{ entry.path }}">{{ entry.version }}</a></td>
                    <td>{{ entry.desc | safe_escape }}</td>
                </tr>
                {% endfor %}
                {% endfor %}
            </tbody>
        </table>
    </div>
</body>

</html>
